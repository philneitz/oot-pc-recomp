+        private static bool IsSubgroupSensitive(IAstNode source)
+        {
+            // Subgroup results depend on the invocations active at their original
+            // evaluation site. Inlining a ballot or shuffle into a divergent use
+            // changes that set even when none of its explicit operands changed.
+            // Keep the operation materialized; ordinary pure expressions can still
+            // propagate its local result, and dead unused results can still vanish.
+            return source is AstOperation op && (op.Inst & Instruction.Mask) is
+                Instruction.Ballot or Instruction.VoteAll or Instruction.VoteAllEqual or
+                Instruction.VoteAny or Instruction.Shuffle or Instruction.ShuffleDown or
+                Instruction.ShuffleUp or Instruction.ShuffleXor or Instruction.SwizzleAdd;
+        }
